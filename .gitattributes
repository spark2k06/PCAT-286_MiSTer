# Shell scripts must keep LF in the working tree.  The testbench runners are
# executed through WSL, and bash refuses a script that checkout handed back
# with CRLF line endings.
*.sh text eol=lf
PCAT-286.qsf text eol=lf

# DOS executables. Git's own binary detection already catches these, but a
# .COM that gets line-ending conversion applied to it is corrupt in a way that
# only shows up when it is run on hardware, so say it explicitly.
*.com binary

# Diagnostic metadata records source/generated bytes, so checkout must preserve LF.
tests/firmware/pcat286_event_diag.asm text eol=lf
tests/firmware/pcat286_event_diag.hex text eol=lf
tests/firmware/pcat286_event_diag.json text eol=lf
tests/firmware/pcat286_event_diag_rom_case.svh text eol=lf

