instruction ENTER_FRAME:
    FETCH_IMM16 -> TMP0
    SAVE_ALLOCATION TMP0
    FETCH_IMM8 -> TMP1
    LOAD_COUNTER TMP1
    BEGIN_STACK_CURSOR
    READ_BP -> TMP0
    PUSH16 DECODED TMP0
    READ_STACK_CURSOR -> TMP0
    SAVE_AUX TMP0
    READ_BP -> TMP0
    SET_STACK_ADDRESS TMP0
    BRANCH_ZERO finish
    DECREMENT_COUNTER
    BRANCH_ZERO push_frame
copy_parent:
    DECREMENT_STACK_ADDRESS
    READ_STACK_ADDRESS -> TMP0
    PUSH16 DECODED TMP0
    DECREMENT_COUNTER
    BRANCH_NONZERO copy_parent
push_frame:
    RESTORE_AUX -> TMP0
    PUSH16 DECODED TMP0
finish:
    RESTORE_AUX -> TMP0
    TMP0 -> BP
    ALLOCATE_STACK
    END
instruction LEAVE_FRAME:
